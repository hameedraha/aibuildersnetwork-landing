---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventFeaturedCard from '../../components/EventFeaturedCard.astro';
import EventTimelineItem from '../../components/EventTimelineItem.astro';
import { getCollection } from 'astro:content';
import { getFeaturedEyebrow } from '../../../lib/event-status';
import {
  pickFeaturedEvent,
  resolveEvents,
  sortEventsByDate,
} from '../../utils/events';

const rawEvents = sortEventsByDate(await getCollection('events') ?? []);
const resolvedEvents = resolveEvents(rawEvents);

const live = resolvedEvents.filter((entry) => entry.status === 'live');
const upcoming = resolvedEvents.filter((entry) => entry.status === 'upcoming');
const past = resolvedEvents.filter((entry) => entry.status === 'past');
const featured = pickFeaturedEvent(resolvedEvents);
const timelineRest = resolvedEvents.filter((entry) => entry.event.id !== featured?.event.id);
const hasActiveEvents = live.length > 0 || upcoming.length > 0;

const nextEvent = live[0] ?? upcoming[0] ?? null;
const nextLabel = nextEvent
  ? nextEvent.event.data.eventDate
      .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
      .toLowerCase()
  : 'tba';
const nextEyebrow = live.length > 0 ? 'live now' : nextEvent ? 'next date' : 'next date';

// the one earned vermilion moment in the ink hero: whichever count is "hot"
const accentStat = live.length > 0 ? 'live' : upcoming.length > 0 ? 'upcoming' : 'next';
---

<BaseLayout
  title="events · ai builders network"
  description="workshops, meetups, and builder gatherings from ai builders network."
>
  <header class="events-hero section--ink" aria-labelledby="events-heading">
    <div class="container events-hero__inner">
      <div class="events-hero__lead">
        <span class="eyebrow eyebrow--on-ink">gatherings</span>
        <h1 class="display-l" id="events-heading">events.</h1>
        <p class="body-lg events-hero__desc">
          {hasActiveEvents
            ? "workshops and in-person sessions for builders shipping with ai. what's on now, what's next."
            : 'workshops and in-person sessions for builders shipping with ai. browse past gatherings and what is coming next.'}
        </p>
      </div>

      <div class="events-hero__grid" role="presentation">
        <div class:list={['events-hero__cell', accentStat === 'live' && 'events-hero__cell--accent']}>
          <span class="events-hero__num">{String(live.length).padStart(2, '0')}</span>
          <span class="eyebrow eyebrow--on-ink">live</span>
        </div>
        <div class:list={['events-hero__cell', accentStat === 'upcoming' && 'events-hero__cell--accent']}>
          <span class="events-hero__num">{String(upcoming.length).padStart(2, '0')}</span>
          <span class="eyebrow eyebrow--on-ink">upcoming</span>
        </div>
        <div class="events-hero__cell">
          <span class="events-hero__num">{String(past.length).padStart(2, '0')}</span>
          <span class="eyebrow eyebrow--on-ink">past</span>
        </div>
        <div class:list={['events-hero__cell', accentStat === 'next' && 'events-hero__cell--accent']}>
          <span class="events-hero__num events-hero__num--date">{nextLabel}</span>
          <span class="eyebrow eyebrow--on-ink">{nextEyebrow}</span>
        </div>
      </div>
    </div>
  </header>

  {featured && (
    <>
      <div class="section-divider" role="separator"></div>
      <section class="section--neutral events-featured-section" aria-label="featured event">
        <div class="container">
          <span class="eyebrow" data-event-featured-eyebrow>
            {getFeaturedEyebrow(featured.status)}
          </span>
          <EventFeaturedCard event={featured.event} status={featured.status} />
        </div>
      </section>
    </>
  )}

  <div class="section-divider" role="separator"></div>

  <section class="section--neutral events-timeline-section" aria-label="event timeline">
    <div class="container">
      <div class="events-timeline__intro">
        <span class="eyebrow">timeline</span>
        <h2 class="display-l events-timeline__heading">the schedule.</h2>
        <p class="body-md events-timeline__lede">
          every gathering aibn has run and every one on the calendar, oldest to newest.
        </p>
      </div>

      <ol class="events-timeline">
        {timelineRest.map((entry) => (
          <EventTimelineItem event={entry.event} status={entry.status} />
        ))}

        <li class="events-timeline__item events-timeline__item--future">
          <div class="events-timeline__rail" aria-hidden="true">
            <span class="events-timeline__marker events-timeline__marker--future"></span>
          </div>
          <article class="events-timeline__card events-timeline__card--future">
            <span class="eyebrow">on the horizon</span>
            <h3 class="heading">more events coming soon.</h3>
            <p class="body-md events-timeline__desc">
              weekly build demos online. more workshops in chennai and beyond. join the network to get early access.
            </p>
            <a
              href="/community"
              class="btn-secondary btn--sm"
            >
              get notified
            </a>
          </article>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>

<script>
  import { initEventStatus } from '../../scripts/event-status';

  initEventStatus();
  document.addEventListener('astro:page-load', initEventStatus);
</script>

<style>
  /* ═══════════════════════════════
     HERO — the mark becomes the page
  ═══════════════════════════════ */
  .events-hero {
    padding-block: clamp(48px, 8vw, 84px);
    border-bottom: 1px solid rgba(244, 241, 234, 0.1);
  }
  .events-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 7vw, 88px);
    align-items: center;
  }
  .events-hero__lead {
    max-width: 40ch;
  }
  .events-hero .display-l {
    color: var(--c-on-ink);
    margin-block: var(--sp-sm) var(--sp-md);
  }
  .events-hero__desc {
    color: rgba(244, 241, 234, 0.65);
  }

  /* literal 2x2 logo grid: ink quadrants, hairline cross, on ink */
  .events-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: rgba(244, 241, 234, 0.2);
  }
  .events-hero__cell {
    background: var(--c-ink);
    padding: clamp(20px, 3.2vw, 34px);
    min-height: clamp(116px, 15vw, 156px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-md);
  }
  .events-hero__num {
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-on-ink);
    font-variant-numeric: tabular-nums;
  }
  .events-hero__num--date {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }
  .events-hero__cell--accent .events-hero__num {
    color: var(--c-primary);
  }

  /* ═══════════════════════════════
     FEATURED
  ═══════════════════════════════ */
  .events-featured-section {
    padding-block: clamp(44px, 7vw, 80px);
  }
  .events-featured-section .eyebrow {
    display: block;
    margin-bottom: var(--sp-md);
  }

  /* ═══════════════════════════════
     TIMELINE — one continuous spine
  ═══════════════════════════════ */
  .events-timeline-section {
    padding-block: clamp(44px, 7vw, 80px);
  }
  .events-timeline__intro {
    max-width: 640px;
    margin-bottom: var(--sp-lg);
  }
  .events-timeline__heading {
    margin-block: var(--sp-sm) var(--sp-md);
  }
  .events-timeline__lede {
    color: var(--c-muted);
  }

  .events-timeline {
    list-style: none;
    max-width: 820px;
    position: relative;
  }
  /* the spine: a single hairline running the whole list, fading into the future */
  .events-timeline::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 12px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.16) 0%,
      rgba(26, 26, 26, 0.16) 80%,
      rgba(26, 26, 26, 0) 100%
    );
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.events-timeline > li) {
      opacity: 0;
      transform: translateY(8px);
      animation: timeline-in 0.4s cubic-bezier(0.2, 0, 0, 1) forwards;
    }
    :global(.events-timeline > li:nth-child(2)) { animation-delay: 0.05s; }
    :global(.events-timeline > li:nth-child(3)) { animation-delay: 0.1s; }
    :global(.events-timeline > li:nth-child(4)) { animation-delay: 0.15s; }
    :global(.events-timeline > li:nth-child(n + 5)) { animation-delay: 0.2s; }
  }
  @keyframes timeline-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* the "on the horizon" card is hardcoded here, so its layout styles live in this page's scope */
  .events-timeline__item--future {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--sp-md);
    list-style: none;
  }
  .events-timeline__item--future .events-timeline__rail {
    display: flex;
    justify-content: center;
    padding-top: 4px;
  }
  .events-timeline__item--future .events-timeline__marker {
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
    border-radius: var(--r-sm);
    background: var(--c-neutral);
    border: 1px dashed rgba(26, 26, 26, 0.32);
    box-shadow: 0 0 0 5px var(--c-neutral);
  }
  .events-timeline__card--future {
    background: transparent;
    border: 1px dashed rgba(26, 26, 26, 0.18);
    border-radius: var(--r-md);
    padding: var(--sp-md) var(--sp-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }
  .events-timeline__card--future .events-timeline__desc {
    margin-bottom: var(--sp-sm);
    color: var(--c-muted);
    max-width: 58ch;
  }
  .events-timeline__card--future .btn-secondary {
    align-self: flex-start;
  }

  @media (max-width: 820px) {
    .events-hero__inner { grid-template-columns: 1fr; gap: var(--sp-lg); }
    .events-hero__lead { max-width: 46ch; }
  }
  @media (max-width: 640px) {
    .events-timeline__item--future { grid-template-columns: 16px 1fr; gap: var(--sp-sm); }
  }
</style>
