---
import EventLayout from '../../layouts/EventLayout.astro';
import { getCollection, render } from 'astro:content';
import { resolveEventStatus, toEventDateKey } from '../../../lib/event-status';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events
    .map((event) => {
      const slug = event.data.slug ?? event.id;
      if (!slug) return null;
      return {
        params: { slug },
        props: { event },
      };
    })
    .filter((entry) => entry !== null);
}

const { event } = Astro.props;
const { title, description, eventDate, format, location, city, venue, duration, price, hosts, ticketUrl } =
  event.data;

const {
  body: jsonBody = '',
  schedule = [],
  includes = [],
  outcomes = [],
  whoFor = [],
  instructors = [],
  videoGallery = [],
} = event.data;

const isMarkdown = (event.filePath ?? '').endsWith('.md');
// Markdown entries render their prose body via `render()`; JSON entries have no
// renderable body, so long-form copy lives in `data.body` (plain paragraphs).
let Content: any;
let headings: any[] = [];
if (isMarkdown) {
  try {
    const result = await render(event);
    Content = result.Content;
    headings = result.headings ?? [];
  } catch {
    Content = undefined;
    headings = [];
  }
}

const proseParagraphs = !isMarkdown && jsonBody
  ? jsonBody.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];

const status = resolveEventStatus(eventDate);
const eventDateKey = toEventDateKey(eventDate);

const tocHeadings = (headings ?? [])
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ depth: h.depth, text: h.text, slug: h.slug }));
---

<EventLayout
  title={title}
  description={description}
  eventDate={eventDate}
  eventDateKey={eventDateKey}
  format={format}
  location={location}
  city={city}
  venue={venue}
  duration={duration}
  price={price}
  hosts={hosts}
  ticketUrl={ticketUrl}
  status={status}
  headings={tocHeadings}
  schedule={schedule}
  includes={includes}
  outcomes={outcomes}
  whoFor={whoFor}
  instructors={instructors}
  videoGallery={videoGallery}
>
  {Content && <Content />}
  {proseParagraphs.map((p) => <p>{p}</p>)}
</EventLayout>
