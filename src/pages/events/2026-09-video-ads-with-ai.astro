<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hero   = document.getElementById('hero');

    // ---- scroll reveals ----
    var els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('in'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -10% 0px' });
      els.forEach(function (el) { io.observe(el); });
    }

    // ---- proof carousel: arrows + dot indicators, native scroll-snap does the rest ----
    var track = document.getElementById('reel-track');
    if (track) {
      var reel   = track.closest('.reel');
      var prev   = reel.querySelector('.reel-prev');
      var next   = reel.querySelector('.reel-next');
      var cards  = Array.prototype.slice.call(track.children);
      var dotsWrap = document.getElementById('reel-dots');

      cards.forEach(function (_, i) {
        var d = document.createElement('span');
        d.className = 'reel-dot' + (i === 0 ? ' on' : '');
        dotsWrap.appendChild(d);
      });
      var dots = Array.prototype.slice.call(dotsWrap.children);

      function step() {
        var a = cards[0], b = cards[1];
        return b ? (b.offsetLeft - a.offsetLeft) : a.offsetWidth;
      }
      function activeIndex() {
        return Math.round(track.scrollLeft / step());
      }
      function sync() {
        var i = Math.max(0, Math.min(cards.length - 1, activeIndex()));
        dots.forEach(function (d, n) { d.classList.toggle('on', n === i); });
        if (prev) prev.disabled = track.scrollLeft <= 4;
        if (next) next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      }
      function page(dir) {
        var per = Math.max(1, Math.floor(track.clientWidth / step()));
        track.scrollBy({ left: dir * per * step(), behavior: reduce ? 'auto' : 'smooth' });
      }
      if (prev) prev.addEventListener('click', function () { page(-1); });
      if (next) next.addEventListener('click', function () { page(1); });
      var tick;
      track.addEventListener('scroll', function () {
        window.cancelAnimationFrame(tick);
        tick = window.requestAnimationFrame(sync);
      }, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }

    // ---- proof-reel lightbox: mounts a <video> for the picked film ----
    var lb = document.getElementById('lightbox');
    if (lb) {
      var lbMeta   = document.getElementById('lb-meta');
      var lbStage  = document.getElementById('lb-stage');
      var lbClose  = document.getElementById('lb-close');
      var lbReturn = null;

      function openLB(btn) {
        var src = btn.getAttribute('data-src');
        var poster = btn.getAttribute('data-poster') || '';
        var label = btn.getAttribute('aria-label') || 'Ad film';
        lbStage.innerHTML = '';
        var v = document.createElement('video');
        v.src = src;
        if (poster) v.poster = poster;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.setAttribute('playsinline', '');
        v.preload = 'auto';
        v.setAttribute('aria-label', label);
        lbStage.appendChild(v);
        lbMeta.textContent = 'Made with AI. No camera, no crew.';
        lbReturn = btn;
        lb.hidden = false;
        requestAnimationFrame(function () { lb.classList.add('open'); });
        document.body.style.overflow = 'hidden';
        lbClose.focus();
        var p = v.play(); if (p && p.catch) p.catch(function () {});
      }
      function closeLB() {
        lb.classList.remove('open');
        var settled = false;
        var done = function () {
          if (settled) return;
          settled = true;
          lb.hidden = true;
          lbStage.innerHTML = '';           // tear the video down — stops audio + network
          lb.removeEventListener('transitionend', done);
        };
        lb.addEventListener('transitionend', done);
        setTimeout(done, reduce ? 0 : 260);  // fallback if transitionend never fires
        document.body.style.overflow = '';
        if (lbReturn) { lbReturn.focus(); lbReturn = null; }
      }

      document.querySelectorAll('.lb-open').forEach(function (b) {
        b.addEventListener('click', function () { openLB(b); });
      });
      lbClose.addEventListener('click', closeLB);
      lb.addEventListener('click', function (e) { if (e.target === lb) closeLB(); });
      lb.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeLB(); return; }
        if (e.key !== 'Tab') return;
        // focus trap across whatever is focusable in the panel (close button + video controls)
        var f = lb.querySelectorAll('button, video, [href], [tabindex]:not([tabindex="-1"])');
        if (!f.length) { e.preventDefault(); return; }
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
    }

    // ---- sticky mobile buy bar: show once the hero has scrolled away ----
    var buybar = document.getElementById('buybar');
    if (buybar && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var past = !entries[0].isIntersecting;
        buybar.classList.toggle('show', past);
        buybar.setAttribute('aria-hidden', past ? 'false' : 'true');
      }, { threshold: 0 }).observe(hero);
    }

    // ---- final CTA: pause the seabed loop under reduced-motion (poster frame stays) ----
    var seabed = document.querySelector('video.join-seabed');
    if (seabed && reduce) {
      seabed.removeAttribute('autoplay');
      seabed.addEventListener('loadeddata', function () { seabed.pause(); seabed.currentTime = 0; });
      seabed.pause();
    }

    // ---- final CTA: cursor-driven parallax tilt on the 3D stage ----
    var jStage = document.querySelector('#join .join-stage');
    var jSection = document.getElementById('join');
    if (jStage && jSection && !reduce && window.matchMedia('(pointer:fine)').matches) {
      var jPending = false, jx = 0, jy = 0;
      jSection.addEventListener('pointermove', function (e) {
        var r = jSection.getBoundingClientRect();
        jx = (e.clientX - r.left) / r.width - 0.5;
        jy = (e.clientY - r.top) / r.height - 0.5;
        if (!jPending) {
          jPending = true;
          requestAnimationFrame(function () {
            jPending = false;
            jStage.style.setProperty('--jry', (jx * 12).toFixed(2) + 'deg');
            jStage.style.setProperty('--jrx', (jy * -9).toFixed(2) + 'deg');
          });
        }
      });
      jSection.addEventListener('pointerleave', function () {
        jStage.style.setProperty('--jry', '0deg');
        jStage.style.setProperty('--jrx', '0deg');
      });
    }
  })();
</script>

</body>
</html>
