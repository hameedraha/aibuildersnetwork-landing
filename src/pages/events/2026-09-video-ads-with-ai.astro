           radial-gradient(46% 40% at 83% 26%, rgba(255,255,255,0.78), rgba(255,255,255,0) 72%),
           radial-gradient(62% 48% at 64% 90%, rgba(255,255,255,0.62), rgba(255,255,255,0) 75%),
           radial-gradient(120% 92% at 50% 50%, rgba(240,244,250,0.55), rgba(240,244,250,0) 62%),
           linear-gradient(180deg, #eef4fd 0%, #dce9f8 52%, #d4e1f4 100%);"></div>

    <div class="relative mx-auto flex w-full max-w-[1152px] flex-1 flex-col items-center justify-center px-4 py-16">
     <div class="flex w-full max-w-[928px] flex-col items-center text-center">

      <div class="mb-4 flex items-center gap-3 sm:mb-5">
        <svg viewBox="0 0 512 512" class="h-12 w-12 shrink-0 rounded-[10px]" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="512" height="512" fill="#1C1C1E"/>
          <rect x="255" width="2" height="512" fill="url(#aibn0)"/>
          <rect y="255" width="512" height="2" fill="url(#aibn1)"/>
