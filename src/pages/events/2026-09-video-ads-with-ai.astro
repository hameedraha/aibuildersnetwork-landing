<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wght@0,400..800;1,400..800&family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&display=swap">

<style is:inline>
  :root { color-scheme: light; }
  [hidden] { display: none !important; }
  body { background:#EEF2F7; }

  /* Pally (Fontshare) — h1 only. Inlined with absolute https URLs; Fontshare's <link> ships
     protocol-relative src that breaks on file:// (and Fontshare isn't on the Artifact CSP). */
  @font-face { font-family:'Pally'; font-weight:400; font-style:normal; font-display:swap;
    src:url('https://cdn.fontshare.com/wf/H7RRPPQUKUZD2RCEKOG2EUWW2PMPGIYT/CUKSXG3REB7ZF4OU6YXUM2U3W5NYEU3I/CEHOWZ3P4TA7OGFSEAUC7EPX7SYRE24V.woff2') format('woff2'); }
  @font-face { font-family:'Pally'; font-weight:700; font-style:normal; font-display:swap;
    src:url('https://cdn.fontshare.com/wf/V5WYWD27XO3LMOQ4EG2MQK4FRPTA5QJ2/ISQNWVNKUKTQCSPRHYNOUSUBYEKTLRCT/T66H3U7F4BLCEXDVQJD4H2MBK7CL3FOD.woff2') format('woff2'); }
  .reveal { opacity:0; transform:translateY(16px); transition:opacity .5s ease, transform .5s ease; }
  .reveal.in { opacity:1; transform:none; }

  /* large section card — bubble look without the costly backdrop-blur */
  .bubble-card {
    box-shadow:
      inset 0 2px 1px rgba(255,255,255,0.85),
      inset 0 -16px 30px rgba(120,140,210,0.12),
      0 18px 38px -20px rgba(27,35,64,0.30);
  }

  /* ---- proof carousel ---- */
  .reel { position:relative; }
  .reel-track {
    display:flex; gap:1rem; overflow-x:auto; overscroll-behavior-x:contain;
    scroll-snap-type:x proximity; scroll-behavior:smooth;
    padding:4px 2px 6px; -webkit-overflow-scrolling:touch;
    scrollbar-width:none; list-style:none; margin:0;
  }
  .reel-track::-webkit-scrollbar { display:none; }
  .reel-item { flex:0 0 auto; width:clamp(190px,60vw,236px); scroll-snap-align:center; }
  @media (min-width:640px){ .reel-item { width:228px; scroll-snap-align:start; } }
  .reel-card {
    position:relative; display:block; width:100%; aspect-ratio:9/16;
    overflow:hidden; border-radius:20px; background:#d9def0;
    box-shadow:inset 0 2px 1px rgba(255,255,255,0.7), 0 16px 32px -18px rgba(27,35,64,0.45);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .reel-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .reel-item:nth-child(odd)  .reel-card { rotate:-1.4deg; }
  .reel-item:nth-child(even) .reel-card { rotate: 1.4deg; }
  .lb-open:hover .reel-card,
  .lb-open:focus-visible .reel-card { rotate:0deg; transform:translateY(-4px);
    box-shadow:inset 0 2px 1px rgba(255,255,255,0.7), 0 22px 40px -18px rgba(27,35,64,0.5); }
  .reel-play {
    position:absolute; left:50%; top:50%; translate:-50% -50%;
    display:grid; place-items:center; width:52px; height:52px; border-radius:999px;
    padding-left:3px; background:rgba(253,253,255,0.92); color:#5B3BE8;
    box-shadow:0 6px 16px -4px rgba(27,35,64,0.4);
  }
  .reel-nav {
    position:absolute; top:50%; translate:0 -50%; z-index:3;
    display:none; width:44px; height:44px; border-radius:999px;
    align-items:center; justify-content:center;
    background:#FDFDFF; color:#1B2340;
    box-shadow:inset 0 2px 1px rgba(255,255,255,0.9), 0 12px 26px -12px rgba(27,35,64,0.45);
    transition:transform .15s ease, opacity .15s ease;
  }
  .reel-nav:hover { transform:translateY(-50%) scale(1.06); }
  .reel-nav[disabled] { opacity:0; pointer-events:none; }
  .reel-prev { left:-6px; }
  .reel-next { right:-6px; }
  @media (min-width:980px){ .reel-nav { display:flex; } .reel-prev{ left:-20px; } .reel-next{ right:-20px; } }
  .reel-dots { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:1.25rem; }
  .reel-dot { width:7px; height:7px; border-radius:999px; background:rgba(27,35,64,0.2);
    transition:width .2s ease, background .2s ease; }
  .reel-dot.on { width:22px; background:#5B3BE8; }

  /* lightbox */
  #lightbox { position:fixed; inset:0; z-index:60; display:grid; place-items:center; padding:20px;
    background:rgba(20,24,44,0.55); -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px);
    opacity:0; transition:opacity .2s ease; }
  #lightbox.open { opacity:1; }
  #lightbox .lb-panel { transform:scale(.96); transition:transform .2s ease; width:min(460px,100%); }
  #lightbox.open .lb-panel { transform:scale(1); }
  #lb-stage { aspect-ratio:9/16; height:min(74vh,620px); max-width:100%; margin-inline:auto; }
  #lb-stage video { display:block; width:100%; height:100%; object-fit:contain; background:#000; }

  /* sticky mobile buy bar */
  #buybar { position:fixed; inset-inline:0; bottom:0; z-index:40; transform:translateY(115%);
    visibility:hidden; transition:transform .3s cubic-bezier(.22,1,.36,1), visibility .3s; }
  #buybar.show { transform:translateY(0); visibility:visible; }

  @media (prefers-reduced-motion: reduce) {
    #lightbox, #lightbox .lb-panel { transition:none; }
    #buybar { transition:none; }
    .reel-track { scroll-behavior:auto; }
    .reel-card { rotate:0deg !important; transition:none; }
    .reel-nav { transition:none; }
  }

  /* soft "soap-bubble" surfaces — translucent, light caught on top, no strokes */
  .bubble {
    -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px);
    box-shadow:
      inset 0 2px 1px rgba(255,255,255,0.9),
      inset 0 -10px 18px rgba(120,140,210,0.16),
      0 12px 26px -14px rgba(27,35,64,0.32);
  }
  /* die-cut "paper sticker" — the icon shape gets a chunky pale-tint underlay + a lift shadow that
     hugs that silhouette. Full-colour icon rides on top. No box, no border. */
  .sticker { filter: drop-shadow(2px 4px 0 rgba(27,35,64,0.16)); }
  .sticker svg    { overflow: visible; }
  .sticker .halo  { stroke: var(--tint); stroke-width: 10; }
  .sticker .glyph { stroke: currentColor; stroke-width: 1.75; }

  /* small round chips (e.g. hero detail icons) — reads clearly lifted at ~48px */
  .bubble-pop {
    box-shadow:
      inset 0 2px 1px rgba(255,255,255,0.95),
      inset 0 -5px 9px rgba(120,140,210,0.14),
      0 1px 2px rgba(27,35,64,0.12),
      0 6px 12px -3px rgba(27,35,64,0.20),
      0 14px 22px -8px rgba(27,35,64,0.18);
  }
  .bubble-grape {
    background-image: linear-gradient(148deg, #8064f2 0%, #5B3BE8 58%, #4a2fce 100%);
    box-shadow:
      inset 0 3px 3px rgba(255,255,255,0.5),
      inset 0 -12px 20px rgba(24,12,86,0.4),
      0 16px 34px -14px rgba(91,59,232,0.55);
  }
  .bubble-grape:hover { box-shadow:
      inset 0 3px 3px rgba(255,255,255,0.55),
      inset 0 -12px 20px rgba(24,12,86,0.4),
      0 22px 40px -14px rgba(91,59,232,0.6); }
  .mark-grape {
    background-image: linear-gradient(150deg, #8064f2, #5B3BE8 65%, #4a2fce);
    box-shadow: inset 0 2px 2px rgba(255,255,255,0.45), 0 8px 18px -9px rgba(91,59,232,0.5);
  }

  :where(a,button,summary,[tabindex]):focus-visible { outline:3px solid #5B3BE8; outline-offset:3px; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity:1; transform:none; transition:none; }
    * { scroll-behavior:auto !important; }
  }

  /* ============================================================
     SECTION 7 · FINAL CTA — 3D grand-finale stage
     ============================================================ */
  #join {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: 0;
    perspective: 1500px;
    perspective-origin: 50% 34%;
    background: #EEF2F7;
    /* soften the top edge so the glow fades in instead of hard-clipping */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 clamp(48px, 9vw, 104px));
    mask-image: linear-gradient(to bottom, transparent 0, #000 clamp(48px, 9vw, 104px));
  }
  /* animated underwater scene sits BEHIND the slab — the CTA card only clips the top
     ~10% of the clip; the rest of the animation (drifting fish, bubbles) stays visible */
  .join-seabed {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
    max-width: 1400px;
    margin: -3rem auto 0;
    pointer-events: none;
    -webkit-user-select: none; user-select: none;
    /* the clip's ground is a flat light grey — feather all four edges so the
       rectangle melts into the section (top feather is tiny, mostly hidden by the slab) */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%),
                        linear-gradient(to bottom, transparent 0, #000 5%, #000 90%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%),
                linear-gradient(to bottom, transparent 0, #000 5%, #000 90%, transparent 100%);
    mask-composite: intersect;
  }
  @media (max-width: 640px) {
    .join-seabed {
      margin-top: -0.5rem;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%),
                          linear-gradient(to bottom, transparent 0, #000 6%, #000 92%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%),
                  linear-gradient(to bottom, transparent 0, #000 6%, #000 92%, transparent 100%);
      mask-composite: intersect;
    }
  }

  .join-stage {
    position: relative; z-index: 1;
    max-width: 1000px; margin: 0 auto; padding-inline: 1rem;
    transform-style: preserve-3d;
    transform: rotateX(var(--jrx, 0deg)) rotateY(var(--jry, 0deg));
    transition: transform .45s cubic-bezier(.22,1,.36,1);
  }

  /* rotating aurora glow, set well behind the slab */
  .join-aura {
    position: absolute; left: 50%; top: 54%;
    width: 68%; aspect-ratio: 1; border-radius: 50%;
    translate: -50% -50%;
    transform: translateZ(-220px);
    background: conic-gradient(from 0deg,
      #b6a2fb, #c9f0e2, #a9c6f7, #d7bcff, #b6a2fb);
    filter: blur(74px) saturate(1.15);
    opacity: .5;
    animation: jspin 30s linear infinite;
  }
  @keyframes jspin { to { transform: translateZ(-220px) rotate(1turn); } }

  /* the slab */
  .join-card {
    position: relative;
    transform-style: preserve-3d;
    border-radius: 36px;
    padding: clamp(2.5rem, 6vw, 4.75rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    color: #FDFDFF;
    background:
      radial-gradient(120% 140% at 50% -12%, rgba(255,255,255,.30), transparent 55%),
      linear-gradient(158deg, #8567f6 0%, #5B3BE8 52%, #4225bf 100%);
    box-shadow:
      inset 0 3px 2px rgba(255,255,255,.5),
      inset 0 -26px 48px rgba(24,12,86,.42),
      0 13px 0 #4126a8,
      0 24px 0 #35208c,
      0 40px 64px -20px rgba(27,20,80,.5),
      0 0 96px -10px rgba(139,110,252,.5);
    opacity: 0;
    transform: translateY(76px) scale(.92);
    transition: opacity .9s ease, transform 1s cubic-bezier(.2,.85,.2,1);
  }
  .join-card > * { position: relative; }

  .join-title {
    margin: 0;
    font-family: 'Pally','Inter',system-ui,sans-serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 7.2vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transform: translateZ(55px);
    text-shadow:
      0 1px 0 #c8b8ff, 0 2px 0 #b6a2fb, 0 3px 0 #a48ef6,
      0 4px 0 #916fee, 0 6px 0 #7857df, 0 9px 18px rgba(10,4,44,.5);
  }
  .join-meta {
    margin: 1.35rem 0 0;
    font-family: "Mona Sans", Inter, system-ui, sans-serif;
    color: rgba(255,255,255,.85);
    font-size: clamp(.9rem, 2.2vw, 1.05rem);
    letter-spacing: .01em;
    transform: translateZ(38px);
  }
  .join-meta b { color: #fff; font-weight: 600; }

  .join-cta {
    --edge: #b9a7ff;
    position: relative; overflow: hidden;
    display: inline-flex; align-items: baseline; gap: .5rem;
    margin-top: 2.4rem;
    padding: 1.15rem 3rem;
    border-radius: 999px;
    font-family: "Mona Sans", Inter, system-ui, sans-serif;
    font-weight: 700; font-size: 1.2rem;
    color: #5B3BE8; background: #FDFDFF;
    transform: translateZ(70px);
    box-shadow: 0 9px 0 var(--edge), 0 20px 34px -8px rgba(8,4,40,.55);
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .join-cta span { font-weight: 600; color: rgba(91,59,232,.72); }
  .join-cta:hover  { transform: translateZ(70px) translateY(-4px); box-shadow: 0 13px 0 var(--edge), 0 28px 44px -8px rgba(8,4,40,.6); }
  .join-cta:active { transform: translateZ(70px) translateY(4px);  box-shadow: 0 4px 0 var(--edge),  0 12px 22px -8px rgba(8,4,40,.5); }
  .join-cta::after {
    content: ""; position: absolute; top: 0; left: -60%; width: 42%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.85), transparent);
    transform: skewX(-18deg);
    animation: jshine 4.5s ease-in-out infinite;
  }
  @keyframes jshine { 0%, 58% { left: -60%; } 100% { left: 135%; } }

  /* floating bubbles at varied depth */
  .join-orb {
    position: absolute; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle at 32% 30%,
      rgba(255,255,255,.92), rgba(201,184,242,.5) 45%, rgba(127,168,245,.22) 72%, transparent 80%);
    box-shadow:
      inset 0 2px 6px rgba(255,255,255,.7),
      inset 0 -8px 14px rgba(91,59,232,.12),
      0 20px 38px -14px rgba(27,35,64,.26);
    opacity: 0;
    transition: opacity 1s ease;
  }
  .join-orb.o1 { width: 132px; height: 132px; left: -4%;  top: 7%;    transform: translateZ(90px);   animation: jfloat 7s   ease-in-out infinite alternate; }
  .join-orb.o2 { width: 84px;  height: 84px;  right: -3%; top: 1%;     transform: translateZ(150px);  animation: jfloat 5.5s ease-in-out infinite alternate; }
  .join-orb.o3 { width: 208px; height: 208px; right: -9%; bottom: 0%;  transform: translateZ(-120px); animation: jfloat 9s   ease-in-out infinite alternate; }
  .join-orb.o4 { width: 64px;  height: 64px;  left: 6%;   bottom: 5%;  transform: translateZ(120px);  animation: jfloat 6.2s ease-in-out infinite alternate; }
  .join-orb.o5 { width: 46px;  height: 46px;  left: 41%;  top: -7%;    transform: translateZ(60px);   animation: jfloat 8s   ease-in-out infinite alternate; }
  @keyframes jfloat { from { translate: 0 0; } to { translate: 0 -26px; } }

  /* orchestrated entrance (fires with the shared .reveal → .in) */
  #join.in .join-card { opacity: 1; transform: translateY(0) scale(1); }
  #join.in .join-orb  { opacity: .9; }
  #join.in .join-orb.o3 { opacity: .7; transition-delay: .1s; }
  #join.in .join-orb.o2 { transition-delay: .18s; }
  #join.in .join-orb.o4 { transition-delay: .26s; }
  #join.in .join-orb.o5 { transition-delay: .32s; }

  @media (prefers-reduced-motion: reduce) {
    .join-aura, .join-cta::after, .join-orb { animation: none; }
    .join-stage { transition: none; transform: none; }
    .join-card  { opacity: 1; transform: none; transition: none; }
    .join-orb   { opacity: .8; }
  }
</style>
</head>

<body class="bg-paper text-ink font-body antialiased">

<main id="main" class="relative z-10">

  <!-- ============ SECTION 1 · HERO ============ -->
